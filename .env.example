# Node
NODE_ENV=development

# Database (MikroORM)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=eurocomply
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ZITADEL Authentication
ZITADEL_INSTANCE_URL=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=your_client_id
ZITADEL_CLIENT_SECRET=your_client_secret
ZITADEL_WEBHOOK_SIGNING_KEY=your_signing_key

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare R2 (DPP Storage)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=eurocomply-dpps-staging
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# walt.id SSI Services (DID/VC Operations)
# For local dev, run: docker-compose --profile waltid up
WALTID_CORE_URL=http://localhost:7000
WALTID_SIGNATORY_URL=http://localhost:7001
WALTID_CUSTODIAN_URL=http://localhost:7002
WALTID_AUDITOR_URL=http://localhost:7003
