# ===========================================
# EuroComply Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://eurocomply:eurocomply@localhost:5432/eurocomply?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
API_KEY_PREFIX=ec_

# walt.id Identity Stack
WALTID_CORE_API=http://localhost:7000
WALTID_SIGNATORY_API=http://localhost:7001
WALTID_CUSTODIAN_API=http://localhost:7002
WALTID_AUDITOR_API=http://localhost:7003

# DID Configuration
DID_METHOD=web
# Options: web (default), ebsi (future)
PLATFORM_DID=did:web:eurocomply.io
PLATFORM_DOMAIN=eurocomply.io

# EBSI (Future - leave empty for now)
EBSI_ENVIRONMENT=
# Options: conformance, pilot, production
EBSI_BEARER_TOKEN=

# External Services
OPENAI_API_KEY=
# For AI-powered document parsing

# S3-Compatible Storage
S3_ENDPOINT=
S3_BUCKET=eurocomply
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-signing-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug, silly

# E-commerce Integrations

# Shopify App (get from Shopify Partners dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
API_HOST=api.eurocomply.io
DASHBOARD_URL=https://dashboard.eurocomply.io

# WooCommerce (webhook signature verification)
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_signing_secret

# GS1 Configuration
GS1_COMPANY_PREFIX=
# Your assigned GS1 company prefix
