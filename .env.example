# Node
NODE_ENV=development

# Database (MikroORM)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eurocomply
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare R2 (DPP Storage)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=eurocomply-dpps-staging
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# walt.id SSI Services (DID/VC Operations)
# For local dev, run: docker-compose --profile waltid up
WALTID_CORE_URL=http://localhost:7000
WALTID_SIGNATORY_URL=http://localhost:7001
WALTID_CUSTODIAN_URL=http://localhost:7002
WALTID_AUDITOR_URL=http://localhost:7003
