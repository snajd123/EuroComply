generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required for Shopify session storage
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// EuroComply DPP sync records
model ProductSync {
  id              String   @id @default(cuid())
  shop            String
  shopifyProductId String
  eurocomplyDppId String?
  lastSyncedAt    DateTime @default(now())
  syncStatus      String   @default("pending") // pending, synced, error
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, shopifyProductId])
  @@index([shop])
}

// Shop settings for EuroComply integration
model ShopSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  eurocomplyApiKey    String?
  eurocomplyOrgId     String?
  autoSyncEnabled     Boolean  @default(true)
  dppTemplateId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
