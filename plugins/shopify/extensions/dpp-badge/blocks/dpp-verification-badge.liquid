{% comment %}
  EuroComply DPP Verification Badge

  Displays a real-time verification badge that shows whether
  the product's sustainability data matches the cryptographically
  signed Verifiable Credential.

  Status States:
  - VERIFIED (green): Data matches VC exactly
  - MODIFIED (yellow): Data changed since VC issuance
  - PENDING (gray): VC not yet issued
  - EXPIRED (yellow): VC has expired
  - REVOKED (red): VC was revoked
  - ERROR (red): Verification failed
{% endcomment %}

{% schema %}
{
  "name": "DPP Verification Badge",
  "target": "section",
  "javascript": "dpp-badge.js",
  "stylesheet": "dpp-badge.css",
  "settings": [
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge Style",
      "options": [
        { "value": "full", "label": "Full Widget (with QR)" },
        { "value": "compact", "label": "Compact Badge" },
        { "value": "minimal", "label": "Minimal Icon Only" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show Technical Details",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_realtime",
      "label": "Real-time Verification",
      "default": true,
      "info": "Fetches live verification status on page load"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Verified Badge Color",
      "default": "#22c55e"
    },
    {
      "type": "color",
      "id": "modified_color",
      "label": "Modified Badge Color",
      "default": "#eab308"
    },
    {
      "type": "text",
      "id": "badge_text_verified",
      "label": "Verified Text",
      "default": "Sustainability Verified"
    },
    {
      "type": "text",
      "id": "badge_text_modified",
      "label": "Modified Text",
      "default": "Data Updated - Re-verification Needed"
    }
  ]
}
{% endschema %}

{% comment %} Get DPP data from product metafields {% endcomment %}
{% assign dpp_id = product.metafields.eurocomply.dpp_id %}
{% assign dpp_hash = product.metafields.eurocomply.data_hash %}
{% assign vc_hash = product.metafields.eurocomply.vc_hash %}
{% assign vc_issued_at = product.metafields.eurocomply.vc_issued_at %}
{% assign vc_status = product.metafields.eurocomply.vc_status %}

{% comment %} Determine initial status (will be updated via JS if realtime enabled) {% endcomment %}
{% if dpp_id == blank %}
  {% assign badge_status = 'none' %}
{% elsif vc_status == 'revoked' %}
  {% assign badge_status = 'revoked' %}
{% elsif dpp_hash == vc_hash %}
  {% assign badge_status = 'verified' %}
{% elsif vc_hash != blank %}
  {% assign badge_status = 'modified' %}
{% else %}
  {% assign badge_status = 'pending' %}
{% endif %}

{% comment %} Only show if product has DPP {% endcomment %}
{% if dpp_id != blank %}
<div class="eurocomply-dpp-badge"
     data-product-id="{{ product.id }}"
     data-dpp-id="{{ dpp_id }}"
     data-current-hash="{{ dpp_hash }}"
     data-vc-hash="{{ vc_hash }}"
     data-status="{{ badge_status }}"
     data-style="{{ block.settings.badge_style }}"
     data-realtime="{{ block.settings.enable_realtime }}">

  {% case block.settings.badge_style %}

  {% when 'full' %}
    {%- comment -%} Full widget with QR code {%- endcomment -%}
    <div class="eurocomply-widget eurocomply-widget--{{ badge_status }}">
      <div class="eurocomply-widget__header">
        <span class="eurocomply-widget__label">DIGITAL PRODUCT PASSPORT</span>
        <span class="eurocomply-widget__title">EU ESPR Compliant</span>
      </div>

      <div class="eurocomply-widget__qr">
        <div class="eurocomply-qr-placeholder" data-qr-target>
          <svg width="120" height="120" viewBox="0 0 120 120">
            <rect fill="#f3f4f6" width="120" height="120" rx="8"/>
            <text x="60" y="65" text-anchor="middle" fill="#9ca3af" font-size="12">Loading QR...</text>
          </svg>
        </div>
        <span class="eurocomply-widget__qr-hint">Scan to verify authenticity</span>
      </div>

      <div class="eurocomply-widget__status">
        <div class="eurocomply-badge eurocomply-badge--{{ badge_status }}">
          <span class="eurocomply-badge__icon" data-icon></span>
          <span class="eurocomply-badge__text" data-text>
            {% case badge_status %}
              {% when 'verified' %}{{ block.settings.badge_text_verified }}
              {% when 'modified' %}{{ block.settings.badge_text_modified }}
              {% when 'pending' %}Verification Pending
              {% when 'revoked' %}Credential Revoked
              {% else %}Not Available
            {% endcase %}
          </span>
        </div>
        <p class="eurocomply-widget__message" data-message></p>
      </div>

      {% if block.settings.show_details %}
      <details class="eurocomply-widget__details">
        <summary>Technical Details</summary>
        <div class="eurocomply-widget__details-content">
          <div><strong>Data Hash:</strong> <code data-current-hash>{{ dpp_hash | truncate: 12, '...' }}</code></div>
          <div><strong>VC Hash:</strong> <code data-vc-hash>{{ vc_hash | truncate: 12, '...' }}</code></div>
          {% if vc_issued_at %}<div><strong>Issued:</strong> <span data-issued-at>{{ vc_issued_at | date: '%B %d, %Y' }}</span></div>{% endif %}
        </div>
      </details>
      {% endif %}

      <a href="{{ shop.url }}/apps/eurocomply/verify/{{ dpp_id }}"
         target="_blank"
         rel="noopener"
         class="eurocomply-widget__verify-btn">
        Verify Credential →
      </a>

      <div class="eurocomply-widget__footer">
        Powered by EuroComply • W3C Verifiable Credential
      </div>
    </div>

  {% when 'compact' %}
    {%- comment -%} Compact badge {%- endcomment -%}
    <a href="{{ shop.url }}/apps/eurocomply/verify/{{ dpp_id }}"
       target="_blank"
       rel="noopener"
       class="eurocomply-badge eurocomply-badge--compact eurocomply-badge--{{ badge_status }}"
       title="Click to verify this product's sustainability credentials">
      <span class="eurocomply-badge__icon" data-icon>
        {% case badge_status %}
          {% when 'verified' %}✓
          {% when 'modified' %}⚠
          {% when 'pending' %}⏳
          {% when 'revoked' %}⊘
          {% else %}?
        {% endcase %}
      </span>
      <span class="eurocomply-badge__text" data-text>
        {% case badge_status %}
          {% when 'verified' %}{{ block.settings.badge_text_verified }}
          {% when 'modified' %}{{ block.settings.badge_text_modified }}
          {% when 'pending' %}Verification Pending
          {% when 'revoked' %}Credential Revoked
          {% else %}DPP Available
        {% endcase %}
      </span>
      <svg class="eurocomply-badge__shield" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        {% if badge_status == 'verified' %}<path d="M9 12l2 2 4-4"/>{% endif %}
      </svg>
    </a>

  {% when 'minimal' %}
    {%- comment -%} Minimal icon only {%- endcomment -%}
    <a href="{{ shop.url }}/apps/eurocomply/verify/{{ dpp_id }}"
       target="_blank"
       rel="noopener"
       class="eurocomply-badge eurocomply-badge--minimal eurocomply-badge--{{ badge_status }}"
       title="{% case badge_status %}{% when 'verified' %}Sustainability data verified{% when 'modified' %}Data modified since verification{% when 'pending' %}Verification pending{% when 'revoked' %}Credential revoked{% else %}Digital Product Passport available{% endcase %}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        {% case badge_status %}
          {% when 'verified' %}<path d="M9 12l2 2 4-4" stroke="#22c55e"/>
          {% when 'modified' %}<path d="M12 8v4M12 16h.01" stroke="#eab308"/>
          {% when 'revoked' %}<path d="M8 8l8 8M16 8l-8 8" stroke="#ef4444"/>
        {% endcase %}
      </svg>
    </a>

  {% endcase %}
</div>
{% endif %}
