# Shopify App Credentials (from partners.shopify.com)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret

# App URL (set by Shopify CLI during development)
SHOPIFY_APP_URL=https://your-tunnel.trycloudflare.com

# Database for session storage
DATABASE_URL=postgresql://eurocomply:eurocomply@localhost:5432/shopify_app?schema=public

# EuroComply API
EUROCOMPLY_API_URL=http://localhost:3000
EUROCOMPLY_API_KEY=ec_your_api_key

# OAuth Scopes
SCOPES=read_products,write_products,read_orders,read_inventory
