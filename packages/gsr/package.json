{
  "name": "@eurocomply/gsr",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gsr": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./test-utils": {
      "import": "./dist/test-utils.js",
      "types": "./dist/test-utils.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "gsr": "node --env-file=../../.env ./dist/cli/index.js",
    "seed:echa-inventory": "node --env-file=../../.env ./dist/cli/index.js seed echa-inventory",
    "seed:echa-svhc": "node --env-file=../../.env ./dist/cli/index.js seed echa-svhc"
  },
  "dependencies": {
    "@eurocomply/database": "workspace:*",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/postgresql": "^6.4.3",
    "@paralleldrive/cuid2": "^2.2.2",
    "commander": "^12.0.0",
    "csv-parse": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc/core": "^1.10.7",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.4"
  }
}
