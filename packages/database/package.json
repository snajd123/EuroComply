    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eurocomply/core": "workspace:*",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@swc/core": "^1.4.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
