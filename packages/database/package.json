{
  "name": "@eurocomply/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./entities": {
      "import": "./dist/entities/index.js",
      "types": "./dist/entities/index.d.ts"
    },
    "./test-utils": {
      "import": "./dist/test-utils.js",
      "types": "./dist/test-utils.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node dist/cli/setup.js",
    "seed:substances": "node dist/cli/seed-substances.js",
    "seed:check": "node dist/cli/seed-check.js",
    "seed:categories": "node dist/cli/seed-categories.js"
  },
  "dependencies": {
    "@eurocomply/core": "workspace:*",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "pg-copy-streams": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@swc/core": "^1.4.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/ui": "2.1.9",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
}
