// EuroComply Database Schema
// Digital Product Passport Infrastructure for ESPR Compliance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// CORE: Multi-tenant Organization Management
// ===========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?  @unique

  // Identity (walt.id)
  did         String?  @unique // did:web:eurocomply.io:o:{slug}
  keyId       String?  // walt.id key reference for signing
  didDocument Json?    // Cached DID document for hosting

  // Subscription & Billing
  plan        Plan     @default(FREE)
  stripeCustomerId String?

  // Settings
  settings    Json     @default("{}")

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  apiKeys     ApiKey[]
  teamMembers TeamMember[]
  webhooks    Webhook[]
  products    Product[]
  auditLogs   AuditLog[]

  @@index([slug])
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  keyHash        String   @unique // Hashed API key (never store plaintext)
  keyPrefix      String   // First 8 chars for identification (ec_live_xxxxxxxx)

  // Permissions
  scopes         String[] @default(["*"])

  // Security
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([keyPrefix])
  @@index([organizationId])
}

model TeamMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  role           TeamRole @default(MEMBER)

  // Auth (for dashboard access)
  passwordHash   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  url            String
  events         String[] // Event types to subscribe to
  secret         String   // For signing webhook payloads

  isActive       Boolean  @default(true)

  // Stats
  lastTriggeredAt DateTime?
  failureCount   Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ===========================================
// PRODUCT TRUST: Digital Product Passports
// ===========================================

model Product {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Product Identification
  name           String
  description    String?
  sku            String?
  gtin           String?  // Global Trade Item Number (EAN/UPC)

  // GS1 Digital Link
  gs1DigitalLink String?  // Full GS1 Digital Link URL

  // Product Data (CIRPASS compatible)
  attributes     Json     @default("{}") // Flexible attribute storage

  // Sustainability
  sustainabilityClaims Json @default("[]")

  // Status
  status         ProductStatus @default(DRAFT)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  passports      Passport[]
  lifecycleEvents LifecycleEvent[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([gtin])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Passport {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Passport Data
  version        String   @default("1.0")
  data           Json     // Full DPP data (CIRPASS schema)

  // Verifiable Credential (DPP as VC)
  credentialId   String?  @unique // VC ID (urn:uuid:...)
  vcJwt          String?  @db.Text // Signed JWT credential
  credential     Json?    // Cached VC JSON

  // QR Code
  qrCodeUrl      String?  // Generated QR code image URL
  qrCodeData     String?  // QR code payload

  // Blockchain Anchoring
  anchorStatus   AnchorStatus @default(NONE)
  anchorTxHash   String?
  anchoredAt     DateTime?

  // Verification
  verificationUrl String? // Public verification URL

  // Status
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
}

enum AnchorStatus {
  NONE
  PENDING
  ANCHORED
  FAILED
}

model LifecycleEvent {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Event Details
  eventType      LifecycleEventType
  description    String?
  data           Json     @default("{}")

  // For unsold goods tracking (ESPR Article 20)
  quantity       Int?
  reason         String?  // Destruction reason for ESPR

  // Timestamps
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([eventType])
}

enum LifecycleEventType {
  MANUFACTURED
  SHIPPED
  RECEIVED
  SOLD
  RETURNED
  RECYCLED
  DESTROYED      // ESPR unsold goods tracking
  DONATED
  REPAIRED
  REFURBISHED
}

// ===========================================
// AUDIT & LOGGING
// ===========================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Actor
  actorType      ActorType
  actorId        String?
  actorEmail     String?

  // Action
  action         String
  resourceType   String
  resourceId     String?

  // Details
  details        Json     @default("{}")

  // Request Info
  ipAddress      String?
  userAgent      String?

  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
  WEBHOOK
}
