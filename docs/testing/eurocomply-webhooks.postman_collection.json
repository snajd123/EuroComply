{
  "info": {
    "_postman_id": "eurocomply-webhooks",
    "name": "EuroComply Webhooks",
    "description": "Simulated Clerk webhook events for local testing.\n\n**SETUP REQUIRED:**\n1. Set `webhookSecret` variable to your CLERK_WEBHOOK_SECRET (starts with `whsec_`)\n2. Get it from Clerk Dashboard → Webhooks → Signing Secret\n\n**Execution Order:**\n1. organization.created\n2. organizationMembership.created (First User)\n3. organizationMembership.created (Second User)\n4. user.updated\n5. organizationMembership.deleted\n6. organization.deleted",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "webhookSecret",
      "value": "",
      "type": "string",
      "description": "REQUIRED: Your CLERK_WEBHOOK_SECRET (starts with whsec_)"
    },
    {
      "key": "clerkOrgId",
      "value": "",
      "type": "string",
      "description": "Auto-generated on organization.created"
    },
    {
      "key": "clerkUserId",
      "value": "",
      "type": "string",
      "description": "Auto-generated on first membership.created"
    },
    {
      "key": "clerkUserId2",
      "value": "",
      "type": "string",
      "description": "Auto-generated on second membership.created"
    },
    {
      "key": "schemaName",
      "value": "",
      "type": "string",
      "description": "Returned from organization.created"
    },
    {
      "key": "internalOrgId",
      "value": "",
      "type": "string",
      "description": "Internal org ID from response"
    },
    {
      "key": "firstUserId",
      "value": "",
      "type": "string",
      "description": "Internal user ID of first user"
    },
    {
      "key": "secondUserId",
      "value": "",
      "type": "string",
      "description": "Internal user ID of second user"
    }
  ],
  "item": [
    {
      "name": "Organization Webhooks",
      "item": [
        {
          "name": "1. organization.created",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique org ID for this test run",
                  "const orgId = 'org_test_' + Math.random().toString(36).substring(2, 10);",
                  "pm.collectionVariables.set('clerkOrgId', orgId);",
                  "console.log('Generated clerkOrgId:', orgId);",
                  "",
                  "// ===========================================",
                  "// SVIX SIGNATURE GENERATION",
                  "// ===========================================",
                  "",
                  "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('webhookSecret must be set in collection variables (starts with whsec_)');",
                  "}",
                  "",
                  "// Generate message ID and timestamp",
                  "const msgId = 'msg_' + Math.random().toString(36).substring(2, 15);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "",
                  "// Build the exact body that will be sent",
                  "const body = JSON.stringify({",
                  "  type: 'organization.created',",
                  "  data: {",
                  "    id: orgId,",
                  "    name: 'Test Organization',",
                  "    slug: 'test-organization',",
                  "    created_at: parseInt(timestamp)",
                  "  }",
                  "});",
                  "",
                  "// Decode the secret (remove whsec_ prefix and base64 decode)",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "",
                  "// Create signature: HMAC-SHA256(msgId.timestamp.body, secret)",
                  "const signaturePayload = msgId + '.' + timestamp + '.' + body;",
                  "const signature = CryptoJS.HmacSHA256(signaturePayload, secretBytes);",
                  "const svixSignature = 'v1,' + CryptoJS.enc.Base64.stringify(signature);",
                  "",
                  "// Set headers programmatically",
                  "pm.request.headers.upsert({ key: 'svix-id', value: msgId });",
                  "pm.request.headers.upsert({ key: 'svix-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'svix-signature', value: svixSignature });",
                  "",
                  "// Replace request body with the exact signed body",
                  "pm.request.body.raw = body;",
                  "",
                  "console.log('Svix headers set:');",
                  "console.log('  svix-id:', msgId);",
                  "console.log('  svix-timestamp:', timestamp);",
                  "console.log('  svix-signature:', svixSignature.substring(0, 30) + '...');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Organization created successfully', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.schemaName).to.exist;",
                  "    pm.expect(response.organizationId).to.exist;",
                  "",
                  "    pm.collectionVariables.set('schemaName', response.schemaName);",
                  "    pm.collectionVariables.set('internalOrgId', response.organizationId);",
                  "",
                  "    console.log('Schema created:', response.schemaName);",
                  "    console.log('Internal org ID:', response.organizationId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/clerk",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "clerk"]
            },
            "description": "Creates an organization record and provisions the tenant schema.\n\n**Auto-generates:** `clerkOrgId`\n**Saves:** `schemaName`, `internalOrgId`"
          },
          "response": []
        },
        {
          "name": "6. organization.deleted",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const orgId = pm.collectionVariables.get('clerkOrgId');",
                  "if (!orgId) {",
                  "    throw new Error('clerkOrgId not set. Run organization.created first.');",
                  "}",
                  "console.log('Deleting organization:', orgId);",
                  "",
                  "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('webhookSecret must be set in collection variables (starts with whsec_)');",
                  "}",
                  "",
                  "const msgId = 'msg_' + Math.random().toString(36).substring(2, 15);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "",
                  "const body = JSON.stringify({",
                  "  type: 'organization.deleted',",
                  "  data: {",
                  "    id: orgId,",
                  "    name: 'Test Organization',",
                  "    slug: 'test-organization',",
                  "    created_at: parseInt(timestamp)",
                  "  }",
                  "});",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const signaturePayload = msgId + '.' + timestamp + '.' + body;",
                  "const signature = CryptoJS.HmacSHA256(signaturePayload, secretBytes);",
                  "const svixSignature = 'v1,' + CryptoJS.enc.Base64.stringify(signature);",
                  "",
                  "pm.request.headers.upsert({ key: 'svix-id', value: msgId });",
                  "pm.request.headers.upsert({ key: 'svix-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'svix-signature', value: svixSignature });",
                  "pm.request.body.raw = body;",
                  "",
                  "console.log('Svix headers set for organization.deleted');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Organization deleted successfully', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "",
                  "    console.log('Organization deleted:', response.organizationId);",
                  "    console.log('Schema dropped:', response.schemaName);",
                  "",
                  "    pm.collectionVariables.unset('clerkOrgId');",
                  "    pm.collectionVariables.unset('schemaName');",
                  "    pm.collectionVariables.unset('internalOrgId');",
                  "    pm.collectionVariables.unset('clerkUserId');",
                  "    pm.collectionVariables.unset('clerkUserId2');",
                  "    pm.collectionVariables.unset('firstUserId');",
                  "    pm.collectionVariables.unset('secondUserId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/clerk",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "clerk"]
            },
            "description": "Drops the tenant schema and deletes the organization record.\n\n**Requires:** `clerkOrgId` (from step 1)\n**Clears:** All collection variables"
          },
          "response": []
        }
      ],
      "description": "Organization lifecycle webhooks from Clerk."
    },
