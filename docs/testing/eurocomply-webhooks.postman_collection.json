          "name": "Check Schema Exists",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This is a placeholder - run in Adminer or psql",
                  "console.log('=== Run this SQL in Adminer (http://localhost:8080) ===');",
                  "console.log('');",
                  "const schemaName = pm.collectionVariables.get('schemaName');",
                  "console.log('Schema name:', schemaName);",
                  "console.log('');",
                  "console.log('-- Check schema exists');",
                  "console.log(`SELECT schema_name FROM information_schema.schemata WHERE schema_name = '${schemaName}';`);",
