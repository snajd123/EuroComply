{
  "info": {
    "name": "4. user.updated",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "webhookSecret", "value": "", "description": "REQUIRED: CLERK_WEBHOOK_SECRET (whsec_...)" },
    { "key": "clerkOrgId", "value": "", "description": "From organization.created" },
    { "key": "clerkUserId", "value": "", "description": "From membership.created" }
  ],
  "item": [
    {
      "name": "user.updated",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const orgId = pm.collectionVariables.get('clerkOrgId');",
              "const userId = pm.collectionVariables.get('clerkUserId');",
              "if (!orgId || !userId) throw new Error('Set clerkOrgId and clerkUserId first');",
              "",
              "const timestamp = Math.floor(Date.now() / 1000);",
              "",
              "pm.variables.set('_clerkUserId', userId);",
              "pm.variables.set('_clerkOrgId', orgId);",
              "pm.variables.set('_timestamp', timestamp);",
              "",
              "console.log('Updating user:', userId);",
              "",
              "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
              "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
              "    throw new Error('Set webhookSecret in collection variables (whsec_...)');",
              "}",
              "",
              "const body = '{\"type\":\"user.updated\",\"data\":{\"id\":\"' + userId + '\",\"email_addresses\":[{\"email_address\":\"updated@example.com\",\"id\":\"email_123\"}],\"primary_email_address_id\":\"email_123\",\"first_name\":\"Updated\",\"last_name\":\"Name\",\"image_url\":\"https://example.com/new.png\",\"organization_memberships\":[{\"organization\":{\"id\":\"' + orgId + '\"}}]}}';",
              "",
              "const msgId = 'msg_' + Math.random().toString(36).substring(2, 15);",
              "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
              "const signaturePayload = msgId + '.' + timestamp + '.' + body;",
              "const signature = CryptoJS.HmacSHA256(signaturePayload, secretBytes);",
              "const svixSignature = 'v1,' + CryptoJS.enc.Base64.stringify(signature);",
              "",
              "pm.variables.set('_svixId', msgId);",
              "pm.variables.set('_svixTimestamp', timestamp.toString());",
              "pm.variables.set('_svixSignature', svixSignature);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Response:', pm.response.text());",
              "",
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Update queued', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.status).to.equal('queued');",
              "    console.log('Queued for', r.count, 'org(s)');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "svix-id", "value": "{{_svixId}}" },
          { "key": "svix-timestamp", "value": "{{_svixTimestamp}}" },
          { "key": "svix-signature", "value": "{{_svixSignature}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"user.updated\",\"data\":{\"id\":\"{{_clerkUserId}}\",\"email_addresses\":[{\"email_address\":\"updated@example.com\",\"id\":\"email_123\"}],\"primary_email_address_id\":\"email_123\",\"first_name\":\"Updated\",\"last_name\":\"Name\",\"image_url\":\"https://example.com/new.png\",\"organization_memberships\":[{\"organization\":{\"id\":\"{{_clerkOrgId}}\"}}]}}"
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/clerk",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "clerk"]
        }
      }
    }
  ]
}
