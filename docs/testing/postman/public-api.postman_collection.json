{
  "info": {
    "name": "EuroComply - Public API",
    "_postman_id": "eurocomply-public-api",
    "description": "Public API endpoints - no authentication required.\n\nIncludes:\n- Health check\n- Units (UNECE codes)\n- Substances (ECHA regulated chemicals)\n- System Categories (taxonomy)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns healthy status', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.status).to.equal('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "API Version",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns API v1', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.message).to.include('v1');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1"
          }
        }
      ]
    },
    {
      "name": "Units",
      "description": "UNECE measurement unit codes",
      "item": [
        {
          "name": "List All Units",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns units array', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data).to.be.an('array');",
                  "    pm.expect(r.meta.total).to.be.at.least(30);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/units"
          }
        },
        {
          "name": "Get Unit (KGM - Kilogram)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns kilogram', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.code).to.equal('KGM');",
                  "    pm.expect(r.data.system).to.equal('MASS');",
                  "    pm.expect(r.data.isBase).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/units/KGM"
          }
        },
        {
          "name": "Get Unit Not Found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error code NOT_FOUND', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.error.code).to.equal('NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/units/INVALID"
          }
        },
        {
          "name": "Convert Units (kg to lb)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Converts 10kg to ~22lb', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.from.val).to.equal(10);",
                  "    pm.expect(r.data.from.unit).to.equal('KGM');",
                  "    pm.expect(r.data.to.unit).to.equal('LBR');",
                  "    pm.expect(r.data.to.val).to.be.within(22, 23);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/units/convert?from=KGM&to=LBR&value=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "units", "convert"],
              "query": [
                { "key": "from", "value": "KGM" },
                { "key": "to", "value": "LBR" },
                { "key": "value", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter Units by System",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All units are MASS system', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.length).to.be.at.least(3);",
                  "    r.data.forEach(u => pm.expect(u.system).to.equal('MASS'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/units?system=MASS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "units"],
              "query": [{ "key": "system", "value": "MASS" }]
            }
          }
        }
      ]
    },
    {
      "name": "Substances",
      "description": "ECHA regulated substances registry",
      "item": [
        {
          "name": "List All Substances",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns substances array', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data).to.be.an('array');",
                  "    pm.expect(r.meta.total).to.be.at.least(20);",
                  "});",
                  "",
                  "pm.test('Substances have required fields', function () {",
                  "    const r = pm.response.json();",
                  "    const s = r.data[0];",
                  "    pm.expect(s.casNumber).to.match(/^\\d{2,7}-\\d{2}-\\d$/);",
                  "    pm.expect(s.primaryName).to.be.a('string');",
                  "    pm.expect(s).to.have.property('isSvhc');",
                  "    pm.expect(s).to.have.property('isRestricted');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances"
          }
        },
        {
          "name": "Filter by SVHC",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All results are SVHC', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.length).to.be.at.least(10);",
                  "    r.data.forEach(s => pm.expect(s.isSvhc).to.equal(true));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/substances?svhc=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "substances"],
              "query": [{ "key": "svhc", "value": "true" }]
            }
          }
        },
        {
          "name": "Filter by Restricted",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All results are restricted', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.length).to.be.at.least(10);",
                  "    r.data.forEach(s => pm.expect(s.isRestricted).to.equal(true));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/substances?restricted=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "substances"],
              "query": [{ "key": "restricted", "value": "true" }]
            }
          }
        },
        {
          "name": "Search by Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Search finds lead', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.length).to.be.at.least(1);",
                  "    const names = r.data.map(s => s.primaryName.toLowerCase());",
                  "    pm.expect(names.some(n => n.includes('lead'))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/substances?search=lead",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "substances"],
              "query": [{ "key": "search", "value": "lead" }]
            }
          }
        },
        {
          "name": "Get All Regulated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns regulated substances with counts', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.length).to.be.at.least(15);",
                  "    pm.expect(r.meta.svhcCount).to.be.a('number');",
                  "    pm.expect(r.meta.restrictedCount).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('All results are regulated', function () {",
                  "    const r = pm.response.json();",
                  "    r.data.forEach(s => {",
                  "        const isRegulated = s.isSvhc || s.requiresAuthorization || s.isRestricted;",
                  "        pm.expect(isRegulated).to.be.true;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances/regulated"
          }
        },
        {
          "name": "Get Substance by CAS (DMAC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns DMAC', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.casNumber).to.equal('127-19-5');",
                  "    pm.expect(r.data.primaryName).to.equal('N,N-Dimethylacetamide');",
                  "    pm.expect(r.data.isSvhc).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances/127-19-5"
          }
        },
        {
          "name": "Get Substance by CAS (Lead)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns Lead with RoHS restriction', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.casNumber).to.equal('7439-92-1');",
                  "    pm.expect(r.data.primaryName).to.equal('Lead');",
                  "    pm.expect(r.data.isRestricted).to.be.true;",
                  "    pm.expect(r.data.restrictionConditions).to.include('RoHS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances/7439-92-1"
          }
        },
        {
          "name": "Substance Not Found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error code NOT_FOUND', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.error.code).to.equal('NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances/9999-99-9"
          }
        },
        {
          "name": "Get Substance Aliases",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns DMAC aliases', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data).to.be.an('array');",
                  "    pm.expect(r.data.length).to.be.at.least(2);",
                  "    pm.expect(r.meta.casNumber).to.equal('127-19-5');",
                  "    const names = r.data.map(a => a.name);",
                  "    pm.expect(names).to.include('DMAC');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/substances/127-19-5/aliases"
          }
        }
      ]
    },
    {
      "name": "Categories (System Taxonomy)",
      "description": "Public system category taxonomy",
      "item": [
        {
          "name": "List System Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns categories array', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data).to.be.an('array');",
                  "    pm.expect(r.meta.total).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/categories"
          }
        },
        {
          "name": "Get Root Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All results are roots (depth=0)', function () {",
                  "    const r = pm.response.json();",
                  "    r.data.forEach(c => pm.expect(c.depth).to.equal(0));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/taxonomy/categories/roots"
          }
        },
        {
          "name": "Filter by Target Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All results are PRODUCT type', function () {",
                  "    const r = pm.response.json();",
                  "    r.data.forEach(c => pm.expect(c.targetType).to.equal('PRODUCT'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/taxonomy/categories?targetType=PRODUCT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "taxonomy", "categories"],
              "query": [{ "key": "targetType", "value": "PRODUCT" }]
            }
          }
        }
      ]
    }
  ]
}
