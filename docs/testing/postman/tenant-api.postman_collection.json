{
  "info": {
    "name": "EuroComply - Tenant API",
    "_postman_id": "eurocomply-tenant-api",
    "description": "Tenant-scoped API endpoints.\n\n**Two authentication methods:**\n1. **JWT Auth** (human via UI) - Clerk session, used for dashboard operations\n2. **API Key Auth** (machine) - Programmatic access for integrations/scripts\n\n**Run order:** Setup → JWT Auth Tests → API Key Auth Tests → Cleanup\n\n**SETUP:** Import `eurocomply-local.postman_environment.json` and set `webhookSecret`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "clerkOrgId", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "schemaName", "value": "", "type": "string" },
    { "key": "clerkUserId", "value": "", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string", "description": "Mock JWT for human/UI simulation" },
    { "key": "editorApiKey", "value": "", "type": "string" },
    { "key": "viewerApiKey", "value": "", "type": "string" },
    { "key": "orgAdminApiKey", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Creates organization and user via webhooks. Run first.",
      "item": [
        {
          "name": "0.1 Create Organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const webhookSecret = pm.variables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('Set webhookSecret in environment (import eurocomply-local.postman_environment.json)');",
                  "}",
                  "",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "const orgId = 'org_tenant_' + suffix;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_' + suffix;",
                  "",
                  "pm.collectionVariables.set('clerkOrgId', orgId);",
                  "",
                  "const body = JSON.stringify({",
                  "    type: 'organization.created',",
                  "    data: { id: orgId, name: 'Tenant Test ' + suffix, slug: 'tenant-test-' + suffix, created_at: parseInt(timestamp) }",
                  "});",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const signature = CryptoJS.HmacSHA256(svixId + '.' + timestamp + '.' + body, secretBytes);",
                  "",
                  "pm.request.headers.upsert({ key: 'svix-id', value: svixId });",
                  "pm.request.headers.upsert({ key: 'svix-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'svix-signature', value: 'v1,' + CryptoJS.enc.Base64.stringify(signature) });",
                  "pm.request.body.raw = body;"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const r = pm.response.json();",
                  "    pm.collectionVariables.set('orgId', r.data.organizationId);",
                  "    pm.collectionVariables.set('schemaName', r.data.schemaName);",
                  "    console.log('Org:', r.data.organizationId);",
                  "    console.log('Schema:', r.data.schemaName);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/webhooks/clerk"
          }
        },
        {
          "name": "0.2 Create User (Org Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const webhookSecret = pm.variables.get('webhookSecret');",
                  "const clerkOrgId = pm.collectionVariables.get('clerkOrgId');",
                  "if (!clerkOrgId) throw new Error('Run 0.1 first');",
                  "",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "const userId = 'user_tenant_' + suffix;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_mem_' + suffix;",
                  "",
                  "pm.collectionVariables.set('clerkUserId', userId);",
                  "",
                  "const body = JSON.stringify({",
                  "    type: 'organizationMembership.created',",
                  "    data: {",
                  "        id: 'mem_' + suffix,",
                  "        organization: { id: clerkOrgId },",
                  "        public_user_data: { user_id: userId, identifier: userId + '@test.com', first_name: 'Test', last_name: 'Admin' },",
                  "        role: 'org:admin',",
                  "        created_at: parseInt(timestamp)",
                  "    }",
                  "});",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const signature = CryptoJS.HmacSHA256(svixId + '.' + timestamp + '.' + body, secretBytes);",
                  "",
                  "pm.request.headers.upsert({ key: 'svix-id', value: svixId });",
                  "pm.request.headers.upsert({ key: 'svix-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'svix-signature', value: 'v1,' + CryptoJS.enc.Base64.stringify(signature) });",
                  "pm.request.body.raw = body;"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const schemaName = pm.collectionVariables.get('schemaName');",
                  "    const clerkUserId = pm.collectionVariables.get('clerkUserId');",
                  "",
                  "    // Create mock JWT for subsequent tests (simulates Clerk session)",
                  "    const payload = { sub: clerkUserId, org_metadata: { schema_name: schemaName } };",
                  "    const jwt = 'header.' + btoa(JSON.stringify(payload)) + '.signature';",
                  "    pm.collectionVariables.set('jwtToken', jwt);",
                  "    console.log('User created, JWT token set for UI simulation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/webhooks/clerk"
          }
        }
      ]
    },
