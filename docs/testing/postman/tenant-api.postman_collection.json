            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/api/v1/tenant-categories/{{categoryId}}"
          }
        },
        {
          "name": "9.3 Delete Organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const webhookSecret = pm.variables.get('webhookSecret');",
                  "const clerkOrgId = pm.collectionVariables.get('clerkOrgId');",
                  "if (!clerkOrgId) throw new Error('No org to delete');",
                  "",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_del_' + Math.random().toString(36).substring(2, 8);",
                  "",
                  "const body = JSON.stringify({",
                  "    type: 'organization.deleted',",
                  "    data: { id: clerkOrgId, name: 'Test', slug: 'test', created_at: parseInt(timestamp) }",
                  "});",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const signature = CryptoJS.HmacSHA256(svixId + '.' + timestamp + '.' + body, secretBytes);",
                  "",
                  "pm.request.headers.upsert({ key: 'svix-id', value: svixId });",
                  "pm.request.headers.upsert({ key: 'svix-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'svix-signature', value: 'v1,' + CryptoJS.enc.Base64.stringify(signature) });",
                  "pm.request.body.raw = body;"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization deleted', function () {",
                  "    pm.response.to.have.status(200);",
                  "",
                  "    // Clear all variables",
                  "    const vars = ['clerkOrgId', 'orgId', 'schemaName', 'clerkUserId', 'jwtToken',",
                  "                  'editorApiKey', 'viewerApiKey', 'orgAdminApiKey', 'categoryId', 'productId'];",
                  "    vars.forEach(v => pm.collectionVariables.unset(v));",
                  "    console.log('Cleanup complete');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/webhooks/clerk"
          }
        }
      ]
    }
  ]
}
