{
  "info": {
    "name": "3. organizationMembership.created (Second User)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "webhookSecret", "value": "", "description": "REQUIRED: CLERK_WEBHOOK_SECRET (whsec_...)" },
    { "key": "clerkOrgId", "value": "", "description": "From organization.created" },
    { "key": "clerkUserId2", "value": "" },
    { "key": "secondUserId", "value": "" }
  ],
  "item": [
    {
      "name": "organizationMembership.created (Second User)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const orgId = pm.collectionVariables.get('clerkOrgId');",
              "if (!orgId) throw new Error('Set clerkOrgId first (run organization.created)');",
              "",
              "const userId = 'user_member_' + Math.random().toString(36).substring(2, 10);",
              "const memId = 'mem_second_' + Date.now();",
              "const timestamp = Math.floor(Date.now() / 1000);",
              "",
              "pm.collectionVariables.set('clerkUserId2', userId);",
              "pm.variables.set('_memId', memId);",
              "pm.variables.set('_clerkUserId', userId);",
              "pm.variables.set('_clerkOrgId', orgId);",
              "pm.variables.set('_timestamp', timestamp);",
              "",
              "console.log('Creating second user:', userId, 'in org:', orgId);",
              "",
              "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
              "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
              "    throw new Error('Set webhookSecret in collection variables (whsec_...)');",
              "}",
              "",
              "const body = '{\"type\":\"organizationMembership.created\",\"data\":{\"id\":\"' + memId + '\",\"organization\":{\"id\":\"' + orgId + '\"},\"public_user_data\":{\"user_id\":\"' + userId + '\",\"identifier\":\"member@example.com\",\"first_name\":\"Regular\",\"last_name\":\"Member\",\"image_url\":null},\"role\":\"org:member\",\"created_at\":' + timestamp + '}}';",
              "",
              "const msgId = 'msg_' + Math.random().toString(36).substring(2, 15);",
              "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
              "const signaturePayload = msgId + '.' + timestamp + '.' + body;",
              "const signature = CryptoJS.HmacSHA256(signaturePayload, secretBytes);",
              "const svixSignature = 'v1,' + CryptoJS.enc.Base64.stringify(signature);",
              "",
              "pm.variables.set('_svixId', msgId);",
              "pm.variables.set('_svixTimestamp', timestamp.toString());",
              "pm.variables.set('_svixSignature', svixSignature);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Response:', pm.response.text());",
              "",
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('User created with NONE permissions', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(['created', 'already_exists']).to.include(r.status);",
              "    if (r.userId) pm.collectionVariables.set('secondUserId', r.userId);",
              "    console.log('Status:', r.status, 'UserId:', r.userId);",
              "    console.log('This user has NONE permissions - will get 403 on protected routes');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "svix-id", "value": "{{_svixId}}" },
          { "key": "svix-timestamp", "value": "{{_svixTimestamp}}" },
          { "key": "svix-signature", "value": "{{_svixSignature}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"organizationMembership.created\",\"data\":{\"id\":\"{{_memId}}\",\"organization\":{\"id\":\"{{_clerkOrgId}}\"},\"public_user_data\":{\"user_id\":\"{{_clerkUserId}}\",\"identifier\":\"member@example.com\",\"first_name\":\"Regular\",\"last_name\":\"Member\",\"image_url\":null},\"role\":\"org:member\",\"created_at\":{{_timestamp}}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/clerk",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "clerk"]
        }
      }
    }
  ]
}
