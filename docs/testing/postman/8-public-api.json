{
  "info": {
    "name": "8. Public API (No Auth)",
    "description": "Tests public endpoints that require no authentication: health check, API version, and taxonomy/units.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns healthy status', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.status).to.equal('healthy');",
              "    pm.expect(r.timestamp).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "API Version",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns API v1 message', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.message).to.equal('EuroComply API v1');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1"]
        }
      }
    },
    {
      "name": "List All Units",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns units array', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data).to.be.an('array');",
              "    pm.expect(r.meta.total).to.be.a('number');",
              "    console.log('Total units:', r.meta.total);",
              "});",
              "",
              "pm.test('Units have required fields', function () {",
              "    const r = pm.response.json();",
              "    if (r.data.length > 0) {",
              "        const unit = r.data[0];",
              "        pm.expect(unit).to.have.property('code');",
              "        pm.expect(unit).to.have.property('name');",
              "        pm.expect(unit).to.have.property('symbol');",
              "        pm.expect(unit).to.have.property('system');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units"]
        }
      }
    },
    {
      "name": "List Units by System (MASS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('All units are MASS system', function () {",
              "    const r = pm.response.json();",
              "    r.data.forEach(unit => {",
              "        pm.expect(unit.system).to.equal('MASS');",
              "    });",
              "    console.log('MASS units:', r.meta.total);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units?system=MASS",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units"],
          "query": [
            { "key": "system", "value": "MASS" }
          ]
        }
      }
    },
    {
      "name": "List Active Units Only",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('All units are active', function () {",
              "    const r = pm.response.json();",
              "    r.data.forEach(unit => {",
              "        pm.expect(unit.isActive).to.equal(true);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units?active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units"],
          "query": [
            { "key": "active", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Get Unit by Code (KGM)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns kilogram unit', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.code).to.equal('KGM');",
              "    pm.expect(r.data.name).to.include('ilogram');",
              "    pm.expect(r.data.system).to.equal('MASS');",
              "    pm.expect(r.data.isBase).to.equal(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units/KGM",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units", "KGM"]
        }
      }
    },
    {
      "name": "Get Unit - Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Returns error message', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Not Found');",
              "    pm.expect(r.message).to.include('INVALID');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units/INVALID",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units", "INVALID"]
        }
      }
    },
    {
      "name": "Convert Units (kg to lb)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Converts 10 kg to pounds', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.from.val).to.equal(10);",
              "    pm.expect(r.data.from.unit).to.equal('KGM');",
              "    pm.expect(r.data.to.unit).to.equal('LBR');",
              "    // 10 kg ≈ 22.046 lb",
              "    pm.expect(r.data.to.val).to.be.within(22, 23);",
              "    console.log('10 kg =', r.data.to.val, 'lb');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units/convert?from=KGM&to=LBR&value=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units", "convert"],
          "query": [
            { "key": "from", "value": "KGM" },
            { "key": "to", "value": "LBR" },
            { "key": "value", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Convert Units (m to cm)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Converts 2.5 m to cm', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.from.val).to.equal(2.5);",
              "    pm.expect(r.data.to.val).to.equal(250);",
              "    console.log('2.5 m =', r.data.to.val, 'cm');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units/convert?from=MTR&to=CMT&value=2.5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units", "convert"],
          "query": [
            { "key": "from", "value": "MTR" },
            { "key": "to", "value": "CMT" },
            { "key": "value", "value": "2.5" }
          ]
        }
      }
    },
    {
      "name": "Convert Units - Incompatible Systems",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Returns error for incompatible systems', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Bad Request');",
              "    console.log('Error:', r.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/taxonomy/units/convert?from=KGM&to=MTR&value=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "taxonomy", "units", "convert"],
          "query": [
            { "key": "from", "value": "KGM" },
            { "key": "to", "value": "MTR" },
            { "key": "value", "value": "10" }
          ]
        }
      }
    }
  ]
}
