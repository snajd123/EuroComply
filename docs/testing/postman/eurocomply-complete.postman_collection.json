                  "        pm.expect(r.success).to.equal(true);",
                  "        console.log('Org and schema deleted');",
                  "    });",
                  "} else if (status === 401) {",
                  "    pm.test('Set adminApiKey to delete org', function () {",
                  "        console.log('Set adminApiKey variable');",
                  "    });",
                  "} else {",
                  "    pm.test('Org deleted or not found', function () {",
                  "        pm.expect([200, 404]).to.include(status);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
