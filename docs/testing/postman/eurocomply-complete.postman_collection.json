    {
      "name": "4. API Keys (JWT Auth)",
      "description": "Create and test API keys with different authorities",
      "item": [
        {
          "name": "4.1 Create EDITOR API Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const schemaName = pm.collectionVariables.get('schemaName');",
                  "const clerkUserId = pm.collectionVariables.get('clerkUserId');",
                  "",
                  "if (!schemaName || !clerkUserId) {",
                  "    throw new Error('Run Setup folder first to create org and user');",
                  "}",
                  "",
                  "const payload = { sub: clerkUserId, org_metadata: { schema_name: schemaName } };",
                  "const token = 'header.' + btoa(JSON.stringify(payload)) + '.signature';",
                  "pm.collectionVariables.set('_jwtToken', token);",
                  "console.log('JWT created for user:', clerkUserId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('EDITOR key created', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.designAuthority).to.equal('EDITOR');",
                  "    pm.expect(r.rawKey).to.be.a('string');",
                  "    pm.collectionVariables.set('editorApiKey', r.rawKey);",
                  "    console.log('EDITOR key:', r.data.keyPrefix);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{_jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Design Editor Key\",\n  \"designAuthority\": \"EDITOR\",\n  \"operationsAuthority\": \"NONE\",\n  \"marketingAuthority\": \"NONE\",\n  \"complianceAuthority\": \"NONE\",\n  \"isOrgAdmin\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "api-keys"]
            }
          }
        },
        {
          "name": "4.2 Create VIEWER API Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const schemaName = pm.collectionVariables.get('schemaName');",
                  "const clerkUserId = pm.collectionVariables.get('clerkUserId');",
                  "const payload = { sub: clerkUserId, org_metadata: { schema_name: schemaName } };",
                  "pm.collectionVariables.set('_jwtToken', 'header.' + btoa(JSON.stringify(payload)) + '.signature');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('VIEWER key created', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.data.designAuthority).to.equal('VIEWER');",
                  "    pm.collectionVariables.set('viewerApiKey', r.rawKey);",
                  "    console.log('VIEWER key:', r.data.keyPrefix);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{_jwtToken}}" }
