        {
          "name": "6.3 Delete Member (Webhook)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('Set webhookSecret variable');",
                  "}",
                  "",
                  "const clerkOrgId = pm.collectionVariables.get('clerkOrgId');",
                  "const clerkUserId2 = pm.collectionVariables.get('clerkUserId2');",
                  "",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_del_' + suffix;",
                  "",
                  "pm.collectionVariables.set('_timestamp', timestamp);",
                  "pm.collectionVariables.set('_svixId', svixId);",
                  "",
                  "const body = JSON.stringify({",
                  "    type: 'organizationMembership.deleted',",
                  "    data: {",
                  "        id: 'mem_delete',",
                  "        organization: { id: clerkOrgId },",
                  "        public_user_data: { user_id: clerkUserId2 }",
                  "    }",
                  "});",
                  "pm.collectionVariables.set('_requestBody', body);",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const toSign = svixId + '.' + timestamp + '.' + body;",
                  "const signature = CryptoJS.HmacSHA256(toSign, secretBytes);",
                  "pm.collectionVariables.set('_svixSignature', 'v1,' + CryptoJS.enc.Base64.stringify(signature));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "svix-id", "value": "{{_svixId}}" },
              { "key": "svix-timestamp", "value": "{{_timestamp}}" },
              { "key": "svix-signature", "value": "{{_svixSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{_requestBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/clerk",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "clerk"]
            }
          }
        },
