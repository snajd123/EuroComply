{
  "info": {
    "name": "EuroComply API Complete",
    "_postman_id": "eurocomply-complete-collection",
    "description": "Complete EuroComply API test suite. Run folders in order: Setup → Public API → Admin API → Tenant API → Cleanup\n\nREQUIRED: Set webhookSecret variable to your CLERK_WEBHOOK_SECRET (whsec_...)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001", "type": "string" },
    { "key": "webhookSecret", "value": "", "type": "string", "description": "REQUIRED: CLERK_WEBHOOK_SECRET (whsec_...)" },
    { "key": "adminApiKey", "value": "", "type": "string", "description": "ADMIN_API_KEY from .env" },
    { "key": "clerkOrgId", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "schemaName", "value": "", "type": "string" },
    { "key": "clerkUserId", "value": "", "type": "string" },
    { "key": "clerkUserId2", "value": "", "type": "string" },
    { "key": "membershipId", "value": "", "type": "string" },
    { "key": "editorApiKey", "value": "", "type": "string" },
    { "key": "viewerApiKey", "value": "", "type": "string" },
    { "key": "orgAdminApiKey", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "_jwtToken", "value": "", "type": "string" },
    { "key": "_timestamp", "value": "", "type": "string" },
    { "key": "_svixId", "value": "", "type": "string" },
    { "key": "_svixSignature", "value": "", "type": "string" },
    { "key": "_requestBody", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Setup (Webhooks)",
      "description": "Run these first to create organization and users. Requires webhookSecret to be set.",
      "item": [
        {
          "name": "1.1 Create Organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Check webhook secret",
                  "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('Set webhookSecret variable to your CLERK_WEBHOOK_SECRET (whsec_...)');",
                  "}",
                  "",
                  "// Generate unique IDs",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "const orgId = 'org_test_' + suffix;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_' + suffix;",
                  "",
                  "pm.collectionVariables.set('clerkOrgId', orgId);",
                  "pm.collectionVariables.set('_timestamp', timestamp);",
                  "pm.collectionVariables.set('_svixId', svixId);",
                  "",
                  "// Build request body",
                  "const body = JSON.stringify({",
                  "    type: 'organization.created',",
                  "    data: {",
                  "        id: orgId,",
                  "        name: 'Test Company ' + suffix,",
                  "        slug: 'test-company-' + suffix,",
                  "        created_at: parseInt(timestamp)",
                  "    }",
                  "});",
                  "pm.collectionVariables.set('_requestBody', body);",
                  "",
                  "// Sign the webhook (Svix signature format)",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const toSign = svixId + '.' + timestamp + '.' + body;",
                  "const signature = CryptoJS.HmacSHA256(toSign, secretBytes);",
                  "const signatureBase64 = CryptoJS.enc.Base64.stringify(signature);",
                  "pm.collectionVariables.set('_svixSignature', 'v1,' + signatureBase64);",
                  "",
                  "console.log('Creating org:', orgId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Organization created and provisioned', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.success).to.equal(true);",
                  "    pm.expect(r.organizationId).to.be.a('string');",
                  "    pm.expect(r.schemaName).to.be.a('string');",
                  "    pm.collectionVariables.set('orgId', r.organizationId);",
                  "    pm.collectionVariables.set('schemaName', r.schemaName);",
                  "    console.log('Org ID:', r.organizationId);",
                  "    console.log('Schema:', r.schemaName);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "svix-id", "value": "{{_svixId}}" },
              { "key": "svix-timestamp", "value": "{{_timestamp}}" },
              { "key": "svix-signature", "value": "{{_svixSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{_requestBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/clerk",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "clerk"]
            }
          }
        },
        {
          "name": "1.2 Create First User (Org Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const webhookSecret = pm.collectionVariables.get('webhookSecret');",
                  "if (!webhookSecret || !webhookSecret.startsWith('whsec_')) {",
                  "    throw new Error('Set webhookSecret variable');",
                  "}",
                  "",
                  "const clerkOrgId = pm.collectionVariables.get('clerkOrgId');",
                  "if (!clerkOrgId) {",
                  "    throw new Error('Run 1.1 Create Organization first');",
                  "}",
                  "",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "const userId = 'user_admin_' + suffix;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const svixId = 'msg_mem_' + suffix;",
                  "",
                  "pm.collectionVariables.set('clerkUserId', userId);",
                  "pm.collectionVariables.set('_timestamp', timestamp);",
                  "pm.collectionVariables.set('_svixId', svixId);",
                  "",
                  "const body = JSON.stringify({",
                  "    type: 'organizationMembership.created',",
                  "    data: {",
                  "        id: 'mem_' + suffix,",
                  "        organization: { id: clerkOrgId },",
                  "        public_user_data: {",
                  "            user_id: userId,",
                  "            identifier: userId + '@test.example.com',",
                  "            first_name: 'Admin',",
                  "            last_name: 'User',",
                  "            image_url: 'https://example.com/avatar.png'",
                  "        },",
                  "        role: 'org:admin',",
                  "        created_at: parseInt(timestamp)",
                  "    }",
                  "});",
                  "pm.collectionVariables.set('_requestBody', body);",
                  "",
                  "const secretBytes = CryptoJS.enc.Base64.parse(webhookSecret.replace('whsec_', ''));",
                  "const toSign = svixId + '.' + timestamp + '.' + body;",
                  "const signature = CryptoJS.HmacSHA256(toSign, secretBytes);",
                  "pm.collectionVariables.set('_svixSignature', 'v1,' + CryptoJS.enc.Base64.stringify(signature));",
                  "",
                  "console.log('Creating admin user:', userId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('First user created', function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.status).to.equal('created');",
                  "    pm.expect(r.userId).to.be.a('string');",
                  "    pm.collectionVariables.set('membershipId', r.userId);",
                  "    console.log('User ID:', r.userId);",
                  "    console.log('First user gets MANAGER + isOrgAdmin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "svix-id", "value": "{{_svixId}}" },
              { "key": "svix-timestamp", "value": "{{_timestamp}}" },
              { "key": "svix-signature", "value": "{{_svixSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{_requestBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/clerk",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "clerk"]
            }
          }
        },
