{
  "info": {
    "name": "7. API Key Workspace Authorization",
    "description": "Tests API key workspace-scoped authorization. Creates keys with different authorities and verifies access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "webhookSecret", "value": "", "description": "REQUIRED: CLERK_WEBHOOK_SECRET (whsec_...)" },
    { "key": "clerkOrgId", "value": "", "description": "From 1-organization-created" },
    { "key": "schemaName", "value": "", "description": "From 1-organization-created" },
    { "key": "clerkUserId", "value": "", "description": "From 2-membership-created-first-user" },
    { "key": "designEditorKey", "value": "" },
    { "key": "viewerOnlyKey", "value": "" },
    { "key": "orgAdminKey", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create Design EDITOR Key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate JWT for first user (org admin)",
              "const schemaName = pm.collectionVariables.get('schemaName');",
              "const clerkUserId = pm.collectionVariables.get('clerkUserId');",
              "",
              "if (!schemaName || !clerkUserId) {",
              "    throw new Error('Run 1-organization-created and 2-membership-created-first-user first');",
              "}",
              "",
              "const payload = {",
              "    sub: clerkUserId,",
              "    org_metadata: { schema_name: schemaName }",
              "};",
              "const token = 'header.' + btoa(JSON.stringify(payload)) + '.signature';",
              "pm.variables.set('_jwtToken', token);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Key has correct authorities', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.designAuthority).to.equal('EDITOR');",
              "    pm.expect(r.data.operationsAuthority).to.equal('NONE');",
              "    pm.expect(r.data.isOrgAdmin).to.equal(false);",
              "    pm.collectionVariables.set('designEditorKey', r.rawKey);",
              "    console.log('Design EDITOR key created:', r.data.keyPrefix);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{_jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Design Editor Key\",\n  \"designAuthority\": \"EDITOR\",\n  \"operationsAuthority\": \"NONE\",\n  \"marketingAuthority\": \"NONE\",\n  \"complianceAuthority\": \"NONE\",\n  \"isOrgAdmin\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-keys"]
        }
      }
    },
    {
      "name": "2. Create VIEWER Only Key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const schemaName = pm.collectionVariables.get('schemaName');",
              "const clerkUserId = pm.collectionVariables.get('clerkUserId');",
              "const payload = { sub: clerkUserId, org_metadata: { schema_name: schemaName } };",
              "pm.variables.set('_jwtToken', 'header.' + btoa(JSON.stringify(payload)) + '.signature');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Key has VIEWER authority', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.designAuthority).to.equal('VIEWER');",
              "    pm.collectionVariables.set('viewerOnlyKey', r.rawKey);",
              "    console.log('VIEWER key created:', r.data.keyPrefix);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{_jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Viewer Only Key\",\n  \"designAuthority\": \"VIEWER\",\n  \"operationsAuthority\": \"NONE\",\n  \"marketingAuthority\": \"NONE\",\n  \"complianceAuthority\": \"NONE\",\n  \"isOrgAdmin\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-keys"]
        }
      }
    },
    {
      "name": "3. Create Org Admin Key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const schemaName = pm.collectionVariables.get('schemaName');",
              "const clerkUserId = pm.collectionVariables.get('clerkUserId');",
              "const payload = { sub: clerkUserId, org_metadata: { schema_name: schemaName } };",
              "pm.variables.set('_jwtToken', 'header.' + btoa(JSON.stringify(payload)) + '.signature');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Key is org admin', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.isOrgAdmin).to.equal(true);",
              "    pm.expect(r.data.designAuthority).to.equal('MANAGER');",
              "    pm.collectionVariables.set('orgAdminKey', r.rawKey);",
              "    console.log('Org Admin key created:', r.data.keyPrefix);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{_jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Org Admin Key\",\n  \"designAuthority\": \"MANAGER\",\n  \"operationsAuthority\": \"MANAGER\",\n  \"marketingAuthority\": \"MANAGER\",\n  \"complianceAuthority\": \"MANAGER\",\n  \"isOrgAdmin\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-keys"]
        }
      }
    },
    {
      "name": "4. EDITOR Key Can View Products (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 - EDITOR can view', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns products array', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{designEditorKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "5. VIEWER Key Can View Products (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 - VIEWER can view', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{viewerOnlyKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "6. VIEWER Key Cannot Create Product (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 403 - VIEWER cannot edit', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('Error shows authority details', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Forbidden');",
              "    pm.expect(r.yourAuthority).to.equal('VIEWER');",
              "    pm.expect(r.workspace).to.equal('design');",
              "    console.log('Correctly denied VIEWER from editing:', r.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{viewerOnlyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Should Fail\",\n  \"categoryId\": \"cat_test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "7. Non-Admin Key Cannot Manage Keys (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 403 - Non-admin cannot manage keys', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('Error mentions Org Admin', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Forbidden');",
              "    pm.expect(r.message).to.include('Organization Admin');",
              "    console.log('Correctly denied non-admin from key management');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{designEditorKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-keys"]
        }
      }
    },
    {
      "name": "8. Admin Key CAN Manage Keys (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 - Admin key can list keys', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Shows all created keys', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data.length).to.be.at.least(3);",
              "    console.log('Admin key successfully listed', r.data.length, 'keys');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{orgAdminKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-keys",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-keys"]
        }
      }
    }
  ]
}
