{
  "info": {
    "name": "9. Admin API (X-Admin-Key)",
    "description": "Tests admin endpoints for organization management. Requires X-Admin-Key header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "adminApiKey", "value": "", "description": "REQUIRED: ADMIN_API_KEY from env" },
    { "key": "testOrgId", "value": "" },
    { "key": "testClerkOrgId", "value": "" },
    { "key": "testSchemaName", "value": "" }
  ],
  "item": [
    {
      "name": "1. List Organizations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns organizations array', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.data).to.be.an('array');",
              "    pm.expect(r.meta.total).to.be.a('number');",
              "    console.log('Total organizations:', r.meta.total);",
              "});",
              "",
              "pm.test('Organizations have required fields', function () {",
              "    const r = pm.response.json();",
              "    if (r.data.length > 0) {",
              "        const org = r.data[0];",
              "        pm.expect(org).to.have.property('id');",
              "        pm.expect(org).to.have.property('name');",
              "        pm.expect(org).to.have.property('slug');",
              "        pm.expect(org).to.have.property('schemaName');",
              "        pm.expect(org).to.have.property('provisioningStatus');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations"]
        }
      }
    },
    {
      "name": "2. List Organizations - No Auth (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401 without admin key', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Returns unauthorized error', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Unauthorized');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations"]
        }
      }
    },
    {
      "name": "3. Create Test Org (via webhook)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Math.random().toString(36).substring(2, 8);",
              "const orgId = 'org_admin_test_' + suffix;",
              "pm.collectionVariables.set('testClerkOrgId', orgId);",
              "pm.variables.set('_orgId', orgId);",
              "pm.variables.set('_orgName', 'Admin Test Org ' + suffix);",
              "pm.variables.set('_orgSlug', 'admin-test-org-' + suffix);",
              "pm.variables.set('_timestamp', Math.floor(Date.now() / 1000));",
              "console.log('Creating test org:', orgId);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Org created and provisioned', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.success).to.equal(true);",
              "    pm.expect(r.provisioningStatus).to.equal('READY');",
              "    pm.collectionVariables.set('testOrgId', r.organizationId);",
              "    pm.collectionVariables.set('testSchemaName', r.schemaName);",
              "    console.log('Created org:', r.organizationId, 'schema:', r.schemaName);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "svix-id", "value": "msg_test" },
          { "key": "svix-timestamp", "value": "{{_timestamp}}" },
          { "key": "svix-signature", "value": "v1,test" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"organization.created\",\"data\":{\"id\":\"{{_orgId}}\",\"name\":\"{{_orgName}}\",\"slug\":\"{{_orgSlug}}\",\"created_at\":{{_timestamp}}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/clerk",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "clerk"]
        },
        "description": "Creates a test organization via webhook. Requires skipSignatureVerification in test mode."
      }
    },
    {
      "name": "4. Get Organization by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns organization details', function () {",
              "    const r = pm.response.json();",
              "    const testOrgId = pm.collectionVariables.get('testOrgId');",
              "    pm.expect(r.data.id).to.equal(testOrgId);",
              "    pm.expect(r.data.provisioningStatus).to.equal('READY');",
              "    console.log('Org name:', r.data.name);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testOrgId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testOrgId}}"]
        }
      }
    },
    {
      "name": "5. Get Organization by Clerk ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Can lookup by Clerk org ID', function () {",
              "    const r = pm.response.json();",
              "    const testClerkOrgId = pm.collectionVariables.get('testClerkOrgId');",
              "    pm.expect(r.data.clerkOrgId).to.equal(testClerkOrgId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testClerkOrgId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testClerkOrgId}}"]
        }
      }
    },
    {
      "name": "6. Get Organization - Not Found (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Returns not found error', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.equal('Not Found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/nonexistent_org_id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "nonexistent_org_id"]
        }
      }
    },
    {
      "name": "7. Get Organization Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns provisioning status', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.provisioningStatus).to.equal('READY');",
              "    pm.expect(r.schemaName).to.be.a('string');",
              "    pm.expect(r.provisioningError).to.be.null;",
              "    console.log('Status:', r.provisioningStatus, 'Schema:', r.schemaName);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testOrgId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testOrgId}}", "status"]
        }
      }
    },
    {
      "name": "8. Provision Already Ready Org (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 - already provisioned', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Returns already provisioned error', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.include('already');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testOrgId}}/provision",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testOrgId}}", "provision"]
        }
      }
    },
    {
      "name": "9. Delete Organization",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Organization deleted', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.success).to.equal(true);",
              "    pm.expect(r.message).to.include('deleted');",
              "    console.log('Deleted org:', r.organizationId, 'schema:', r.schemaName);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testOrgId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testOrgId}}"]
        }
      }
    },
    {
      "name": "10. Delete Already Deleted Org (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Returns not found', function () {",
              "    const r = pm.response.json();",
              "    pm.expect(r.error).to.include('not found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/organizations/{{testOrgId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "admin", "organizations", "{{testOrgId}}"]
        }
      }
    }
  ]
}
