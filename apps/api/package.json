{
  "name": "@eurocomply/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude='**/integration/**' --passWithNoTests",
    "test:integration": "vitest run src/test/integration/",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@eurocomply/db": "workspace:*",
    "@eurocomply/shared": "workspace:*",
    "@eurocomply/walt-id": "workspace:*",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@mikro-orm/core": "^6.6.4",
    "@mikro-orm/postgresql": "^6.6.4",
    "@peculiar/asn1-cms": "^2.6.0",
    "@peculiar/asn1-schema": "^2.3.8",
    "@peculiar/asn1-tsp": "^2.3.8",
    "hono": "^4.0.0",
    "pino": "^10.2.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.10.0",
    "svix": "^1.84.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pino": "^7.0.5",
    "@vitest/coverage-v8": "^1.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
