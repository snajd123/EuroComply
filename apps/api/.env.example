# EuroComply API Environment Configuration
# Copy this file to .env and fill in the values

# ==============================================
# Application Settings
# ==============================================
NODE_ENV=development
PORT=3000

# ==============================================
# Database (PostgreSQL)
# ==============================================
# Local development
DATABASE_URL=postgresql://eurocomply:eurocomply@localhost:5432/eurocomply?schema=public

# Production (AWS RDS) - set via environment variable
# DATABASE_URL=postgresql://eurocomply:PASSWORD@RDS_ENDPOINT:5432/eurocomply?schema=public

# ==============================================
# Redis Cache
# ==============================================
# Local development
REDIS_URL=redis://localhost:6379

# Production (AWS ElastiCache) - set via environment variable
# REDIS_URL=redis://ELASTICACHE_ENDPOINT:6379

# ==============================================
# Authentication
# ==============================================
# JWT secret (minimum 32 characters, use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Token expiration
JWT_EXPIRES_IN=7d

# ==============================================
# CORS Configuration
# ==============================================
# Allowed origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Production
# CORS_ORIGIN=https://eurocomply.eu,https://www.eurocomply.eu,https://app.eurocomply.eu

# ==============================================
# walt.id SSI Stack (Optional - for advanced VC features)
# ==============================================
WALTID_CORE_API=http://localhost:7000
WALTID_SIGNATORY_API=http://localhost:7001
WALTID_CUSTODIAN_API=http://localhost:7002
WALTID_AUDITOR_API=http://localhost:7003

# ==============================================
# External APIs
# ==============================================
# EU VIES VAT validation
VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/services/checkVatService

# ==============================================
# Email (Production)
# ==============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@eurocomply.eu
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=EuroComply <noreply@eurocomply.eu>

# ==============================================
# Stripe (Production)
# ==============================================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=info

# ==============================================
# Rate Limiting
# ==============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
