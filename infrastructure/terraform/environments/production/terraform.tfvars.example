# infrastructure/terraform/environments/production/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and customize values as needed.
# Values shown are the defaults - uncomment and modify to override.

# ==============================================================================
# GENERAL
# ==============================================================================
# aws_region  = "eu-central-1"
# environment = "production"
# app_name    = "eurocomply"
# domain      = "eurocomply.eu"

# ==============================================================================
# NETWORKING
# ==============================================================================
# vpc_cidr              = "10.0.0.0/16"
# public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
# database_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]
# availability_zone_count = 2
# nat_instance_type     = "t4g.nano"
# enable_nat_instance   = true

# ==============================================================================
# DATABASE (RDS)
# ==============================================================================
# db_instance_class        = "db.t4g.small"   # For ~200 tenants
# db_allocated_storage     = 20               # Initial GB
# db_max_allocated_storage = 100              # Max GB for autoscaling
# db_backup_retention_days = 7
# db_multi_az              = false            # Enable for production HA
# db_deletion_protection   = true

# ==============================================================================
# CACHE (ElastiCache Redis)
# ==============================================================================
# redis_node_type              = "cache.t4g.micro"
# redis_num_cache_nodes        = 1
# redis_snapshot_retention_days = 1
# redis_engine_version         = "7.1"

# ==============================================================================
# KMS
# ==============================================================================
# kms_deletion_window_days = 30

# ==============================================================================
# SQS QUEUES
# ==============================================================================
# sqs_message_retention_seconds  = 1209600   # 14 days
# sqs_visibility_timeout_seconds = 300       # 5 minutes
# sqs_dlq_max_receive_count      = 3

# ==============================================================================
# ECS - API Service
# ==============================================================================
# api_cpu           = 512     # CPU units (1024 = 1 vCPU)
# api_memory        = 1024    # Memory in MB
# api_desired_count = 2       # Initial task count
# api_min_count     = 2       # Minimum for autoscaling
# api_max_count     = 10      # Maximum for autoscaling

# ==============================================================================
# ECS - Worker Service
# ==============================================================================
# worker_cpu       = 256
# worker_memory    = 512
# worker_min_count = 0        # Can scale to zero
# worker_max_count = 20       # Burst capacity for bulk jobs

# ==============================================================================
# AUTOSCALING
# ==============================================================================
# api_scale_up_cpu_threshold    = 70
# api_scale_down_cpu_threshold  = 30
# worker_queue_depth_threshold  = 100

# ==============================================================================
# LOGGING
# ==============================================================================
# log_retention_days          = 30
# security_log_retention_days = 90

# ==============================================================================
# TAGGING
# ==============================================================================
# cost_center = "platform"
# owner       = "platform-team"
# additional_tags = {
#   "compliance" = "espr"
#   "data-classification" = "confidential"
# }
