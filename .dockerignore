.env
.env.*
!.env.example

# Docker files (no need to copy into image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Terraform
infrastructure

# IDE and OS files
.DS_Store
*.swp
*.swo
*~

# Logs
*.log
logs

