{
  "name": "eurocomply",
  "version": "0.1.0",
  "private": true,
  "description": "EuroComply - The Stripe for Trust - Compliance Orchestration Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate --filter=@eurocomply/database",
    "db:migrate": "turbo run db:migrate --filter=@eurocomply/database",
    "db:push": "turbo run db:push --filter=@eurocomply/database",
    "db:seed": "turbo run db:seed --filter=@eurocomply/database",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.2.0"
}
